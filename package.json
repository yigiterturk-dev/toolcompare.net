{
  "name": "toolcompare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node app.js",
    "lint": "eslint",
    "test": "node --test \"tests/*.test.ts\"",
    "verify:claims": "node scripts/verify-claims.mjs",
    "check:fiyat": "node scripts/check-fiyat-modelleri.mjs",
    "check:izgara": "node --experimental-strip-types --no-warnings scripts/check-izgara-alanlari.mjs",
    "check": "npm run lint && npm test && npm run denetim && npm run build",
    "gsc:dene": "node --experimental-strip-types --no-warnings scripts/gsc-dene.ts",
    "gsc:senkron": "node --experimental-strip-types --no-warnings scripts/gsc-senkron.ts",
    "gsc:indeks": "node --experimental-strip-types --no-warnings scripts/gsc-indeks.ts",
    "gsc:borc": "node --experimental-strip-types --no-warnings scripts/gsc-borc.ts",
    "gsc:firsat": "node --experimental-strip-types --no-warnings scripts/gsc-firsat.ts",
    "affiliate:sira": "tsx scripts/affiliate-sira.ts",
    "gsc:verim": "tsx scripts/bolum-verim.ts",
    "denetim": "node scripts/verify-claims.mjs && node scripts/check-fiyat-modelleri.mjs && node scripts/check-izgara-alanlari.mjs && node scripts/check-plan-basePrice.mjs",
    "check:plan": "node scripts/check-plan-basePrice.mjs",
    "plan:merdiven": "node scripts/plan-merdiveni.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "framer-motion": "^12.38.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.14.0",
    "mysql2": "^3.24.4",
    "next": "^16.3.4",
    "openai": "^6.37.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
